struct D2DVector
{
	float X;
	float Y;
	D2DVector() {
        this->X = 0;
        this->Y = 0;
    }
    D2DVector(float x, float y) {
        this->X = x;
        this->Y = y;
    }
}; 

struct D3DVector
{
	float X;
	float Y;
	float Z;
	D3DVector() {
        this->X = 0;
        this->Y = 0;
        this->Z = 0;
    }
    D3DVector(float x, float y,float z) {
        this->X = x;
        this->Y = y;
        this->Z = z;
    }
};

struct D4DVector
{
	float X;
	float Y;
	float Z;
	float W;
	D4DVector() {
        this->X = 0;
        this->Y = 0;
        this->Z = 0;
        this->W = 0;
    }
    D4DVector(float x, float y,float z,float w) {
        this->X = x;
        this->Y = y;
        this->Z = z;
        this->W = w;
    }
};
